rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Seluruh state tepercaya hanya boleh diakses Cloud Functions/Admin SDK.
    match /questionBank/{questionId} { allow read, write: if false; }
    match /gameSessions/{sessionId} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }
    match /claims/{claimId} { allow read, write: if false; }
    match /privateContacts/{contactId} { allow read, write: if false; }
    match /rateLimits/{limitId} { allow read, write: if false; }

    // Hanya data yang telah disanitasi server dan belum kedaluwarsa yang publik.
    match /leaderboard/{entryId} {
      allow read: if resource.data.expiresAt > request.time;
      allow create, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
