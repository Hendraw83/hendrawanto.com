{
  "name": "puncak-kemenangan-konsultan-pajak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "bank:build": "node scripts/build-question-banks.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:watch": "vitest",
    "functions:install": "npm --prefix functions install",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "emulators": "npm run bank:build && firebase emulators:start --project demo-puncak-kemenangan",
    "emulators:test": "npm run bank:build && firebase emulators:exec --project demo-puncak-kemenangan \"npm run test && npm run functions:test\"",
    "deploy:firebase": "npm run bank:build && npm run build && npm run functions:build && firebase deploy"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "firebase": "13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "firebase-tools": "15.30.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
